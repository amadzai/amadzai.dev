---
interface Props {
  id: string;
  marker: "circle" | "square" | "triangle";
}

const { id, marker } = Astro.props;
---

<div class="heading relative flex items-center gap-4 pb-4.5">
  <span class:list={["marker", marker]}></span>
  <h2 {id} class="text-[clamp(32px,5vw,48px)] font-extrabold lowercase">
    <slot />
  </h2>
  {/* The rule tapers to a vanishing point with a low sun, like the hero. SVG, not clip-path, so its long edges stay smooth when zoomed out. */}
  <svg
    class="rule"
    viewBox="0 0 100 8"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <polygon points="0,0 100,3.25 100,4.75 0,8" />
  </svg>
</div>

<style>
  /* Stretched across the width, 8px tall, so the polygon's y units are pixels: the thin end is 1.5px. */
  .rule {
    position: absolute;
    left: 0;
    bottom: 2px;
    width: calc(100% - 16px);
    height: 8px;
    fill: var(--color-ink);
  }

  .heading::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-red);
  }

  .marker {
    width: 28px;
    height: 28px;
    flex: none;
    filter: drop-shadow(-6px 6px 0 var(--color-ink));
    transition: rotate 0.5s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  /* Hovering anywhere in the section turns the marker. */
  :global(section:hover) .marker {
    rotate: 90deg;
  }

  /* A circle turning on its own centre looks still, so it turns about a point to its right and swings up instead. */
  .circle {
    border-radius: 50%;
    background: var(--color-red);
    transform-origin: calc(50% + 8px) 50%;
  }

  .square {
    background: var(--color-blue);
  }

  /* Clip a child, not the marker, so the drop shadow keeps the triangle shape. */
  .triangle::before {
    content: "";
    display: block;
    height: 100%;
    background: var(--color-yellow);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
</style>
