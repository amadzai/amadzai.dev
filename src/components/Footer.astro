---
import { buildYear, contactLinks, site } from "../data/site";

// Each link's hero button colour. Yellow text is too faint on paper, so GitHub takes ochre.
const hoverColour: Record<(typeof contactLinks)[number]["label"], string> = {
  Email: "hover:text-red focus-visible:text-red",
  GitHub: "hover:text-ochre focus-visible:text-ochre",
  LinkedIn: "hover:text-blue focus-visible:text-blue",
};
---

<footer class="mt-22 phone:mt-16 flex flex-wrap justify-between gap-4 border-t-3 border-ink pt-5 text-[15px]">
  <span class="flex items-center gap-1.5">
    <span class="size-3.5 rounded-full bg-red" aria-hidden="true"></span>
    <span class="size-3.5 bg-blue" aria-hidden="true"></span>
    <span class="tri size-3.5 bg-yellow" aria-hidden="true"></span>
    &nbsp;{site.name}, {buildYear}
  </span>
  <nav class="flex gap-4" aria-label="Footer">
    {contactLinks.map(({ label, href }) => (
      <a
        href={href}
        target="_blank"
        class:list={[
          "underline transition-colors duration-200",
          hoverColour[label],
        ]}
      >
        {label}
      </a>
    ))}
  </nav>
</footer>

<style>
  .tri {
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
</style>
