---
import { getCollection } from "astro:content";
import { GITHUB_TOKEN } from "astro:env/server";
import SectionHeading from "./SectionHeading.astro";
import { githubActivity, type MarkerColour } from "../lib/github";
import { site } from "../data/site";
import { languageColours } from "../data/languages";

// Only this build-time fetch carries the token.
const withToken: typeof fetch = (input, init) => {
  const headers = new Headers(init?.headers);
  headers.set("Authorization", `Bearer ${GITHUB_TOKEN}`);
  return fetch(input, { ...init, headers });
};

const projects = await getCollection("projects");
const { recentCommits, languageBreakdown } = await githubActivity(
  site.githubUser,
  withToken,
  Object.fromEntries(projects.map(({ id, data }) => [id, data.corner])),
);

// Each colour keeps its Bauhaus shape, as in the footer signature.
const MARKER: Record<MarkerColour, string> = {
  red: "rounded-full bg-red",
  blue: "bg-blue",
  yellow: "tri bg-yellow",
  ink: "bg-ink",
};

// Hover text takes the marker's colour; yellow reads too faintly on paper, so it takes ochre.
const TINT: Record<MarkerColour, string> = {
  red: "group-hover:text-red group-focus-visible:text-red",
  blue: "group-hover:text-blue group-focus-visible:text-blue",
  yellow: "group-hover:text-ochre group-focus-visible:text-ochre",
  ink: "",
};

// Each segment's colour, and its midpoint along the bar, so its tooltip can centre on it.
const segments = languageBreakdown.map(({ name, percent }, i) => ({
  name,
  percent,
  colour: languageColours[name] ?? "var(--color-mute)",
  middle:
    languageBreakdown
      .slice(0, i)
      .reduce((total, language) => total + language.percent, 0) +
    percent / 2,
}));
---

<section aria-labelledby="recent-commits" class="mt-22 phone:mt-16">
  <SectionHeading id="recent-commits" marker="triangle">
    recent commits
  </SectionHeading>
  {/* One shared grid, so every row's headline starts in the same column. */}
  <ol class="mt-4 grid grid-cols-[20px_minmax(130px,auto)_1fr_auto] phone:grid-cols-[20px_1fr_auto]">
    {recentCommits.map(
      ({ repo, headline, additions, deletions, url, colour }) => (
        <li class="col-span-full grid grid-cols-subgrid">
          <a
            href={url}
            target="_blank"
            class="group col-span-full grid grid-cols-subgrid items-center gap-x-3 gap-y-0.5 border-b border-ink/20 py-2.5 text-[17px]"
          >
            <span
              class:list={["size-3.5", MARKER[colour]]}
              aria-hidden="true"
            />
            <b
              class:list={[
                "font-medium transition-colors duration-200 phone:col-span-2",
                TINT[colour],
              ]}
            >
              {repo}
            </b>
            <span
              class:list={[
                "truncate transition-colors duration-200 phone:col-start-2",
                TINT[colour],
              ]}
            >
              {headline}
            </span>
            <span class="text-right font-medium whitespace-nowrap tabular-nums">
              <span class="text-blue">+{additions}</span> /{" "}
              <span class="text-red">−{deletions}</span>
            </span>
          </a>
        </li>
      ),
    )}
  </ol>
  <div class="mt-7 flex items-center gap-5">
    {/* No legend: each segment names itself in a tooltip, and screen readers read that text as a list. */}
    <ul
      aria-label="Language breakdown"
      class="relative flex h-7 flex-1 border-3 border-ink"
    >
      {segments.map(({ name, percent, colour, middle }) => (
        <li
          tabindex="0"
          class="group min-w-1.5 not-first:border-l-3 not-first:border-ink focus:z-10 focus:outline-3 focus:outline-offset-2 focus:outline-blue"
          style={`flex: ${percent} 1 0; background-color: ${colour}`}
        >
          {/* Centred on its segment, but kept inside the bar so it never runs off a narrow screen. */}
          <span
            class="pointer-events-none absolute bottom-full z-10 mb-3.5 grid w-32 translate-y-1.5 border-3 border-ink bg-paper px-3 pt-2 pb-1.5 whitespace-nowrap opacity-0 shadow-[-5px_5px_0_var(--color-ink)] transition-[opacity,translate] duration-150 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100"
            style={`left: clamp(0px, ${middle}% - 4rem, 100% - 8rem)`}
          >
            <span class="flex items-center gap-1.5 text-sm font-medium">
              <span
                class="size-2.5 border-2 border-ink"
                style={`background-color: ${colour}`}
              />
              {name}
            </span>{" "}
            <span class="text-[28px] leading-none font-extrabold">
              {percent.toFixed(1)}%
            </span>
          </span>
        </li>
      ))}
    </ul>
    <a
      href={site.links.github}
      target="_blank"
      class="press rounded-full border-3 border-ink px-4 py-1.5 font-medium whitespace-nowrap hover:bg-yellow hover:text-white"
    >
      View on GitHub
    </a>
  </div>
</section>

<style>
  .tri {
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
</style>
