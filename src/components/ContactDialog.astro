---
import { site } from "../data/site";

// A tile presses into its shadow like the pill buttons, and fills with its marker's colour on hover.
const tile =
  "tile press relative flex cursor-pointer flex-col justify-between gap-7 border-3 border-ink bg-paper p-4 text-left phone:flex-row phone:items-center phone:justify-start phone:gap-4 phone:p-3.5";
---

<dialog
  id="contact"
  aria-labelledby="contact-title"
  class="m-auto w-[min(640px,calc(100%-32px))] backdrop:bg-ink/70 border-3 border-ink bg-paper px-7 pt-7 pb-6 text-ink shadow-[-12px_12px_0_var(--color-ink)] phone:px-4.5 phone:pt-5.5 phone:pb-4.5 phone:shadow-[-8px_8px_0_var(--color-ink)]"
>
  <div class="flex items-center gap-3.5">
    <span
      class="sun size-6.5 flex-none rounded-full bg-red"
      aria-hidden="true"
    ></span>
    <h2
      id="contact-title"
      class="text-[clamp(30px,6vw,48px)] leading-none font-extrabold whitespace-nowrap"
    >
      let's talk
    </h2>
    <button
      type="button"
      data-closes
      aria-label="Close"
      class="press ml-auto size-11 cursor-pointer border-3 border-ink bg-paper text-[22px] font-bold hover:bg-red hover:text-white"
    >
      &times;
    </button>
  </div>
  <p class="mt-4.5 text-[clamp(19px,3.2vw,24px)] font-medium">{site.email}</p>
  <div class="mt-5.5 grid grid-cols-2 gap-3.5 phone:grid-cols-1 phone:gap-3">
    <button
      type="button"
      data-copy
      class:list={[tile, "hover:bg-blue hover:text-white"]}
    >
      {/* Copied: the square flips over to a tick and a rule draws out of it to a low sun, like the section headings. */}
      <span class="flip relative size-8.5 flex-none phone:size-6.5">
        <span class="shape absolute inset-0 bg-blue"></span>
        <span class="back absolute inset-0 grid place-items-center bg-ink"></span>
      </span>
      {/* Level with the square's middle, starting just right of it (tile padding + square + gap); on phones, in the tile's top edge. */}
      <span
        class="rule top-6.75 left-15.5 phone:top-0.5 phone:left-14"
        aria-hidden="true"
      >
        <svg viewBox="0 0 100 8" preserveAspectRatio="none">
          <polygon points="0,0 100,3.25 100,4.75 0,8"></polygon>
        </svg>
      </span>
      <span>
        <b class="block text-[21px] leading-[1.1] font-bold">Copy email</b>
        <small data-note class="mt-1 block text-sm opacity-80">
          To your clipboard
        </small>
      </span>
    </button>
    <a
      href={site.links.call}
      target="_blank"
      class:list={[tile, "hover:bg-yellow hover:text-white"]}
    >
      <span class="shape tri size-8.5 flex-none bg-yellow phone:size-6.5"></span>
      <span>
        <b class="block text-[21px] leading-[1.1] font-bold">Book a call</b>
        <small class="mt-1 block text-sm opacity-80">
          Pick a time on cal.com
        </small>
      </span>
    </a>
  </div>
  <p data-status role="status" class="sr-only"></p>
</dialog>

<script>
  import { site } from "../data/site";

  const COPIED_FOR_MS = 2200;
  const dialog = document.querySelector<HTMLDialogElement>("#contact")!;
  const copyButton = dialog.querySelector<HTMLButtonElement>("[data-copy]")!;
  const note = copyButton.querySelector("[data-note]")!;
  const status = dialog.querySelector("[data-status]")!;
  let resetTimer: ReturnType<typeof setTimeout>;

  document
    .querySelector("[data-opens=contact]")!
    .addEventListener("click", () => dialog.showModal());
  dialog
    .querySelector("[data-closes]")!
    .addEventListener("click", () => dialog.close());
  // A backdrop click targets the dialog itself, as does one on its padding, so check it fell outside the box.
  dialog.addEventListener("click", ({ target, clientX, clientY }) => {
    const { left, right, top, bottom } = dialog.getBoundingClientRect();
    const isOutside =
      clientX < left || clientX > right || clientY < top || clientY > bottom;
    if (target === dialog && isOutside) dialog.close();
  });

  // The older route, for browsers that refuse the Clipboard API.
  const copyByHand = (text: string): boolean => {
    const area = Object.assign(document.createElement("textarea"), {
      value: text,
      readOnly: true,
    });
    area.style.cssText = "position:fixed;opacity:0";
    dialog.append(area);
    area.select();
    const isCopied = document.execCommand("copy");
    area.remove();
    // Selecting the textarea took focus; give it back to the button.
    copyButton.focus();
    return isCopied;
  };

  copyButton.addEventListener("click", async () => {
    let isCopied = true;
    try {
      await navigator.clipboard.writeText(site.email);
    } catch {
      isCopied = copyByHand(site.email);
    }
    // Amad's call: the tile always says Copied; only screen readers hear about a failure.
    note.textContent = "Copied";
    status.textContent = isCopied
      ? `Email copied: ${site.email}`
      : `Couldn't copy. The email is ${site.email}`;
    copyButton.dataset.copied = "";
    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => {
      note.textContent = "To your clipboard";
      status.textContent = "";
      delete copyButton.dataset.copied;
    }, COPIED_FOR_MS);
  });
</script>

<style>
  dialog[open] {
    animation: pop 0.45s cubic-bezier(0.3, 1.3, 0.5, 1);
  }

  dialog[open]::backdrop {
    animation: fade 0.3s;
  }

  .sun {
    filter: drop-shadow(-5px 5px 0 var(--color-ink));
  }

  /* The tiles' shapes turn paper on their hover colour. */
  .tile:hover .shape {
    background: var(--color-paper);
  }

  .tri {
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .flip {
    transform-style: preserve-3d;
    transition: rotate 0.3s cubic-bezier(0.3, 1.3, 0.5, 1);
  }

  .flip > span {
    backface-visibility: hidden;
  }

  .back {
    rotate: y 180deg;
  }

  .back::after {
    content: "";
    width: 70%;
    height: 70%;
    background: var(--color-paper);
    clip-path: polygon(0 55%, 14% 41%, 38% 64%, 86% 14%, 100% 28%, 38% 92%);
  }

  [data-copied] .flip {
    rotate: y 180deg;
  }

  .rule {
    position: absolute;
    right: 16px;
    height: 12px;
    pointer-events: none;
  }

  .rule svg {
    position: absolute;
    left: 0;
    bottom: 2px;
    width: calc(100% - 14px);
    height: 8px;
    fill: currentColor;
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.25s cubic-bezier(0.5, 0, 0.2, 1);
  }

  .rule::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-red);
    scale: 0;
    transition: scale 0.25s 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  [data-copied] .rule svg {
    scale: 1 1;
  }

  [data-copied] .rule::after {
    scale: 1;
  }

  @keyframes pop {
    from {
      scale: 0.85;
      opacity: 0;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>
