---
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";

const roles = (await getCollection("work")).toSorted(
  (a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

// Logo tiles cycle through a square, a circle and a leaf, as in the design.
const tileShapes = ["", "rounded-full", "rounded-[0_50%_0_50%]"];

const formatMonth = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
const isoMonth = (date: Date) => date.toISOString().slice(0, 7);
---

<section aria-labelledby="work" class="mt-[72px]">
  <SectionHeading id="work" marker="circle">
    work
  </SectionHeading>
  <ol>
    {roles.map(({ data }, i) => (
      <li class="grid grid-cols-[56px_1fr_auto] items-center gap-5 border-b border-ink/20 py-[18px] phone:grid-cols-[44px_1fr]">
        <div
          class:list={[
            "logo size-14 border-3 border-ink bg-mute phone:size-11",
            tileShapes[i % tileShapes.length],
          ]}
        />
        <div>
          <b class="block text-[26px] leading-[1.1] font-extrabold">
            {data.company}
          </b>{" "}
          <small class="text-[16px]">{data.role}</small>
        </div>{" "}
        <span class="text-[15px] font-medium tabular-nums phone:col-start-2">
          <time datetime={isoMonth(data.start)}>{formatMonth(data.start)}</time>{" "}
          – <time datetime={isoMonth(data.end)}>{formatMonth(data.end)}</time>
        </span>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Long cast shadow down and to the left, one pixel per step. */
  .logo {
    box-shadow:
      -1px 1px 0 var(--color-cast),
      -2px 2px 0 var(--color-cast),
      -3px 3px 0 var(--color-cast),
      -4px 4px 0 var(--color-cast),
      -5px 5px 0 var(--color-cast),
      -6px 6px 0 var(--color-cast),
      -7px 7px 0 var(--color-cast),
      -8px 8px 0 var(--color-cast),
      -9px 9px 0 var(--color-cast),
      -10px 10px 0 var(--color-cast),
      -11px 11px 0 var(--color-cast),
      -12px 12px 0 var(--color-cast),
      -13px 13px 0 var(--color-cast),
      -14px 14px 0 var(--color-cast);
  }
</style>
