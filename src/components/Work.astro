---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";

const roles = (await getCollection("work")).toSorted(
  (a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

const formatMonth = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
const isoMonth = (date: Date) => date.toISOString().slice(0, 7);
---

<section aria-labelledby="work" class="mt-18">
  <SectionHeading id="work" marker="circle">
    work
  </SectionHeading>
  {/* One shared grid, so each row's summary starts in the same column. */}
  <ol class="grid grid-cols-[56px_auto_1fr_auto] phone:grid-cols-[44px_1fr]">
    {roles.map(({ data }) => (
      <li class="group relative col-span-full grid grid-cols-subgrid items-center gap-5 phone:gap-x-7 phone:gap-y-2 border-b border-ink/20 py-4.5">
        <div class="size-14 phone:size-11">
          {/* 112px covers the 56px logo box at 2x density. */}
          <Image
            src={data.logo}
            alt=""
            width={112}
            class="size-full object-contain"
          />
        </div>
        <div>
          <b class="block text-[26px] leading-[1.1] font-extrabold">
            {/* The link stretches over the whole row, so the row is the click target. */}
            <a
              href={data.url}
              target="_blank"
              style={`--brand: ${data.brand}`}
              class="transition-colors duration-200 group-hover:text-(--brand) focus-visible:text-(--brand) after:absolute after:inset-0"
            >
              {data.company}
            </a>
          </b>{" "}
          <small class="text-[16px]">{data.role}</small>
        </div>{" "}
        <p class="pl-5 text-[15px] text-balance phone:col-start-2 phone:pl-0">
          {data.summary}
        </p>{" "}
        <span class="text-[15px] font-medium tabular-nums phone:col-start-2">
          <time datetime={isoMonth(data.start)}>{formatMonth(data.start)}</time>{" "}
          – <time datetime={isoMonth(data.end)}>{formatMonth(data.end)}</time>
        </span>
      </li>
    ))}
  </ol>
</section>
